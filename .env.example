# Run python scripts/init_env.py to create .env with fresh keys; never commit .env.
JWT_SECRET=
AES_MASTER_KEY=
COOKIE_SECURE=true
PIPELINE_ENABLED=true
# Optional: default SQLite path is .runtime/ppda.db
# DATABASE_URL=sqlite:////absolute/path/ppda.db
# Configure on the backend only. Global prompts go to OpenAI with user consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local LLM runtime. Privacy-mode endpoint must be loopback; a non-loopback URL
# is refused, because intent classification must never leave this host.
# When set, the same runtime classifies intent (app/llm_intent.py) AND that label
# selects the executed task, which is markedly more accurate than the bundled
# 128-feature softmax. Costs one extra loopback inference per message; any
# failure falls back to the softmax model.
#   curl -fsSL https://ollama.com/install.sh | sh && ollama serve
#   ollama pull qwen2.5:1.5b        # ~1 GB; qwen2.5:0.5b and llama3.2:1b are
#                                   # lighter, llama3.2:3b is the best small one
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=
OLLAMA_MODEL=
# No model downloaded? scripts/fake_ollama.py simulates the same loopback API for
# demos and tests. It is a deterministic keyword classifier, NOT a language
# model, and the UI labels it as a simulator:
#   .venv/bin/python scripts/fake_ollama.py --port 11435
#   OLLAMA_URL=http://127.0.0.1:11435
#   OLLAMA_MODEL=simulated-local-llm:demo
# See docs/LOCAL_LLM_INTENT.md for verification and troubleshooting.
# Local-first routing: work the local stack cannot do may be escalated to the
# global model after fl/text_dp.py de-identifies and perturbs the prompt.
# ESCALATION_TOKEN_EPSILON is the per-token k-RR budget (default 10): higher
# keeps more words intact, lower protects more and degrades the escalated
# prompt. It is a per-token guarantee; it is not a whole-prompt epsilon.
# ESCALATION_TOKEN_EPSILON=10.0
# Federated learning stage. "softmax" federates the full 645-weight shared
# matrix; "lora" freezes it and federates a rank-r adapter (W = W0 + A @ B), so a
# client releases r*5 numbers instead of 645. Identical epsilon, delta, ledger
# charge, masking protocol, publication gate and serving path; the adapter simply
# injects about sqrt(r*5/645) of the noise energy into the served model.
# Measure it: .venv/bin/python scripts/measure_dp_stages.py
LEARNING_STAGE=softmax
# LORA_RANK=4
# LORA_CLIP_NORM=0.1
# LORA_LOCAL_STEPS=60
# LORA_LEARNING_RATE=0.5
# Standard same-origin deployment:
COOKIE_SAMESITE=lax
COOKIE_PARTITIONED=false
# Embedded HTTPS preview: set COOKIE_SAMESITE=none and COOKIE_PARTITIONED=true.
# These require COOKIE_SECURE=true. CSRF and strict origin checks remain enabled.

# Browser Web Push: generate the private key with scripts/init_vapid.py.
# Keep the key stable; changing it requires browsers to re-enroll.
# VAPID_PRIVATE_KEY_PATH=/absolute/path/to/vapid-private.pem
VAPID_SUBJECT=mailto:operator@example.com
# Replace the sample subject with your operator contact before production use.
# SNIPS_DIR=/absolute/path/to/models/snips
# Local summarisation: optional CPU dependencies + separately staged public weights.
# See docs/LOCAL_SUMMARIES.md. Missing weights return 503; never silently fall back.
LOCAL_SUMMARY_MODEL=flan-t5-small
# LOCAL_SUMMARY_DIR=/absolute/path/to/summary-models

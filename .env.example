# Run python scripts/init_env.py to create .env with fresh keys; never commit .env.
JWT_SECRET=
AES_MASTER_KEY=
COOKIE_SECURE=true
PIPELINE_ENABLED=true
# Optional: default SQLite path is .runtime/ppda.db
# DATABASE_URL=sqlite:////absolute/path/ppda.db
# Configure on the backend only. Global prompts go to OpenAI with user consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional conversational runtime. Privacy-mode endpoint must be loopback.
OLLAMA_URL=
OLLAMA_MODEL=
# Standard same-origin deployment:
COOKIE_SAMESITE=lax
COOKIE_PARTITIONED=false
# Embedded HTTPS preview: set COOKIE_SAMESITE=none and COOKIE_PARTITIONED=true.
# These require COOKIE_SECURE=true. CSRF and strict origin checks remain enabled.

# Browser Web Push: generate the private key with scripts/init_vapid.py.
# Keep the key stable; changing it requires browsers to re-enroll.
# VAPID_PRIVATE_KEY_PATH=/absolute/path/to/vapid-private.pem
VAPID_SUBJECT=mailto:operator@example.com
# Replace the sample subject with your operator contact before production use.
# SNIPS_DIR=/absolute/path/to/models/snips
# Local summarisation: optional CPU dependencies + separately staged public weights.
# See docs/LOCAL_SUMMARIES.md. Missing weights return 503; never silently fall back.
LOCAL_SUMMARY_MODEL=flan-t5-small
# LOCAL_SUMMARY_DIR=/absolute/path/to/summary-models
